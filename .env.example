# Server-only variables. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required for the initial administrator bootstrap and protected server actions.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_INITIAL_ADMIN_EMAIL=admin@empresa.com

# Legacy Vite names are accepted server-side only during migration.
# They must never contain a service role or secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
